[
 {
  "start": 0.08,
  "end": 1.74,
  "text": "還會再見嗎 夏仁"
 },
 {
  "start": 1.74,
  "end": 3.84,
  "text": "再見的時候你要幸福好不好"
 },
 {
  "start": 3.84,
  "end": 5.58,
  "text": "夏仁 你要開心"
 },
 {
  "start": 5.58,
  "end": 6.84,
  "text": "你要幸福好不好"
 },
 {
  "start": 6.84,
  "end": 8.08,
  "text": "開心啊 幸福"
 },
 {
  "start": 8.08,
  "end": 9.28,
  "text": "你的事件以後沒有我了"
 },
 {
  "start": 9.28,
  "end": 10.48,
  "text": "沒關係 你要幸福"
 },
 {
  "start": 10.48,
  "end": 12.28,
  "text": "你又快樂"
 },
 {
  "start": 12.28,
  "end": 15.28,
  "text": "你的事件沒有加浪了"
 },
 {
  "start": 15.28,
  "end": 17.48,
  "text": "夏仁 沒用你我怎麼活啊"
 },
 {
  "start": 17.48,
  "end": 20.08,
  "text": "你別再想我"
 },
 {
  "start": 20.08,
  "end": 22.08,
  "text": "儘管有他 別走"
 },
 {
  "start": 22.08,
  "end": 23.08,
  "text": "我知道錯了"
 },
 {
  "start": 23.08,
  "end": 24.28,
  "text": "你如果跟我分開"
 },
 {
  "start": 24.28,
  "end": 25.28,
  "text": "我還怎麼活啊"
 },
 {
  "start": 25.28,
  "end": 28.08,
  "text": "期待的本人所可"
 },
 {
  "start": 28.08,
  "end": 42.79,
  "text": "瞎了"
 },
 {
  "start": 42.79,
  "end": 43.99,
  "text": "實在抱歉"
 },
 {
  "start": 43.99,
  "end": 45.99,
  "text": "剛剛亞門禮派人來送信"
 },
 {
  "start": 45.99,
  "end": 48.79,
  "text": "請的西班子在城外被帶人截走"
 },
 {
  "start": 48.79,
  "end": 51.19,
  "text": "今日這些應該是倡不成了"
 },
 {
  "start": 51.19,
  "end": 52.59,
  "text": "城外流口越來越多"
 },
 {
  "start": 52.59,
  "end": 54.19,
  "text": "天下也越來越不太平"
 },
 {
  "start": 54.19,
  "end": 57.19,
  "text": "連西班子都不放過的帶人嘩屍讓人恨"
 },
 {
  "start": 58.39,
  "end": 59.19,
  "text": "鄉親們"
 },
 {
  "start": 59.19,
  "end": 60.39,
  "text": "什麼戲我都會"
 },
 {
  "start": 60.39,
  "end": 62.99,
  "text": "不如這份銀子讓我賺了"
 },
 {
  "start": 62.99,
  "end": 65.19,
  "text": "可上下沒毛的抽小子會個屁"
 },
 {
  "start": 65.19,
  "end": 65.99,
  "text": "我只要你們"
 },
 {
  "start": 65.99,
  "end": 67.79,
  "text": "請西班子的三層的銀子"
 },
 {
  "start": 67.79,
  "end": 69.59,
  "text": "我自己唱 自己拉弦"
 },
 {
  "start": 69.59,
  "end": 70.99,
  "text": "你們還可以點去"
 },
 {
  "start": 70.99,
  "end": 71.59,
  "text": "點什麼"
 },
 {
  "start": 71.59,
  "end": 72.39,
  "text": "我唱什麼"
 },
 {
  "start": 72.59,
  "end": 73.99,
  "text": "劉老爺大獸的日子"
 },
 {
  "start": 73.99,
  "end": 75.59,
  "text": "總得熱鬧 熱鬧不是"
 },
 {
  "start": 76.39,
  "end": 78.39,
  "text": "也小子想前想封了心吧"
 },
 {
  "start": 78.39,
  "end": 80.19,
  "text": "要我說 把他轟下去"
 },
 {
  "start": 80.19,
  "end": 82.19,
  "text": "劉家大老爺還不如撒些同情"
 },
 {
  "start": 82.19,
  "end": 83.39,
  "text": "給大家夥兒讀論"
 },
 {
  "start": 84.39,
  "end": 86.39,
  "text": "原來想前想封了心的人"
 },
 {
  "start": 86.39,
  "end": 87.39,
  "text": "是你"
 },
 {
  "start": 87.39,
  "end": 89.39,
  "text": "信不信我打死你"
 },
 {
  "start": 89.39,
  "end": 89.89,
  "text": "呵呵"
 },
 {
  "start": 89.89,
  "end": 91.89,
  "text": "一會兒你走的時候帶著我"
 },
 {
  "start": 91.89,
  "end": 93.39,
  "text": "你去拿 我跟去拿"
 },
 {
  "start": 93.39,
  "end": 94.59,
  "text": "你還想了我"
 },
 {
  "start": 94.59,
  "end": 96.19,
  "text": "不是 你火氣這麼大"
 },
 {
  "start": 96.19,
  "end": 97.19,
  "text": "不定什麼時候"
 },
 {
  "start": 97.19,
  "end": 97.89,
  "text": "氣死了那"
 },
 {
  "start": 97.89,
  "end": 99.19,
  "text": "我所那吹得最好"
 },
 {
  "start": 99.19,
  "end": 99.79,
  "text": "誰聽了"
 },
 {
  "start": 99.79,
  "end": 101.39,
  "text": "誰都想彈好的那種"
 },
 {
  "start": 101.39,
  "end": 103.39,
  "text": "能送送你 給你半架"
 },
 {
  "start": 103.39,
  "end": 105.19,
  "text": "這次機會我多說兩句"
 },
 {
  "start": 105.19,
  "end": 106.69,
  "text": "諸位父老鄉親家裡"
 },
 {
  "start": 106.69,
  "end": 108.19,
  "text": "有什麼昏傷架取的事"
 },
 {
  "start": 108.19,
  "end": 108.99,
  "text": "遭找我哈"
 },
 {
  "start": 108.99,
  "end": 109.79,
  "text": "白石生蕉"
 },
 {
  "start": 109.79,
  "end": 110.99,
  "text": "鎖納孝子替哭"
 },
 {
  "start": 110.99,
  "end": 112.19,
  "text": "紅石腔羅打鼓"
 },
 {
  "start": 112.19,
  "end": 113.19,
  "text": "撒花住酒"
 },
 {
  "start": 113.19,
  "end": 114.19,
  "text": "頭翼回酒哲"
 },
 {
  "start": 114.19,
  "end": 115.19,
  "text": "第二回半架"
 },
 {
  "start": 115.19,
  "end": 116.19,
  "text": "我叫瞎丟丟"
 },
 {
  "start": 116.19,
  "end": 118.19,
  "text": "什麼事都會一丟丟的瞎丟丟"
 },
 {
  "start": 118.19,
  "end": 119.19,
  "text": "呵呵"
 },
 {
  "start": 120.19,
  "end": 121.19,
  "text": "你等下"
 },
 {
  "start": 121.19,
  "end": 122.19,
  "text": "你要幹嘛"
 },
 {
  "start": 122.79,
  "end": 123.79,
  "text": "他要揍我了"
 },
 {
  "start": 123.79,
  "end": 125.19,
  "text": "現在有人嚇住嗎"
 },
 {
  "start": 125.19,
  "end": 126.99,
  "text": "買我贏的放左邊玩裡"
 },
 {
  "start": 126.99,
  "end": 128.69,
  "text": "買他贏的放右邊玩裡"
 },
 {
  "start": 128.69,
  "end": 129.79,
  "text": "買中了包牌"
 },
 {
  "start": 130.79,
  "end": 131.99,
  "text": "你"
 },
 {
  "start": 131.99,
  "end": 132.99,
  "text": "你揍不揍"
 },
 {
  "start": 132.99,
  "end": 133.59,
  "text": "你不揍"
 },
 {
  "start": 133.59,
  "end": 134.99,
  "text": "別攔著我賺錢"
 },
 {
  "start": 134.99,
  "end": 135.99,
  "text": "呵"
 },
 {
  "start": 135.99,
  "end": 136.99,
  "text": "正經的戲"
 },
 {
  "start": 136.99,
  "end": 137.99,
  "text": "不要賞錢"
 },
 {
  "start": 137.99,
  "end": 139.79,
  "text": "不正經的戲沒賞錢不唱"
 },
 {
  "start": 139.79,
  "end": 140.59,
  "text": "賞錢多了"
 },
 {
  "start": 140.59,
  "end": 141.59,
  "text": "你要多不正經"
 },
 {
  "start": 141.59,
  "end": 142.59,
  "text": "有多不正經"
 },
 {
  "start": 143.59,
  "end": 144.19,
  "text": "家丟丟"
 },
 {
  "start": 144.19,
  "end": 145.19,
  "text": "再堅持"
 },
 {
  "start": 145.19,
  "end": 145.99,
  "text": "再堅持"
 },
 {
  "start": 145.99,
  "end": 147.19,
  "text": "馬上就要賺顧錢"
 },
 {
  "start": 147.19,
  "end": 148.79,
  "text": "給師傅賣房子了"
 },
 {
  "start": 148.79,
  "end": 150.59,
  "text": "少年CP笑臉看著開了"
 },
 {
  "start": 150.59,
  "end": 152.19,
  "text": "卻因生縫萬世中"
 },
 {
  "start": 152.19,
  "end": 153.59,
  "text": "在這個家苦國弱"
 },
 {
  "start": 153.59,
  "end": 155.19,
  "text": "流口横行的天下"
 },
 {
  "start": 155.19,
  "end": 156.59,
  "text": "開啟了一篇一步步"
 },
 {
  "start": 156.59,
  "end": 157.99,
  "text": "成為帝王的故事"
 },
 {
  "start": 158.59,
  "end": 160.19,
  "text": "勇親線歷屬幽州"
 },
 {
  "start": 160.19,
  "end": 161.99,
  "text": "幽州名義上歷屬季州"
 },
 {
  "start": 161.99,
  "end": 163.19,
  "text": "天下十三州"
 },
 {
  "start": 163.19,
  "end": 164.39,
  "text": "季州最亂"
 },
 {
  "start": 164.39,
  "end": 165.19,
  "text": "數日前"
 },
 {
  "start": 165.19,
  "end": 167.39,
  "text": "勇親線被一火流口攻破"
 },
 {
  "start": 167.39,
  "end": 168.59,
  "text": "線牙被燒"
 },
 {
  "start": 168.59,
  "end": 170.59,
  "text": "本就餘涼不多的腐褲被搶辦"
 },
 {
  "start": 170.59,
  "end": 172.19,
  "text": "連紮子都沒剩下"
 },
 {
  "start": 173.39,
  "end": 175.19,
  "text": "比我臉還乾淨"
 },
 {
  "start": 176.19,
  "end": 177.39,
  "text": "比我屁股還乾淨"
 },
 {
  "start": 177.39,
  "end": 178.99,
  "text": "屁股比臉乾淨"
 },
 {
  "start": 178.99,
  "end": 182.14,
  "text": "什麼事到"
 },
 {
  "start": 182.14,
  "end": 183.74,
  "text": "這亂事前不如涼"
 },
 {
  "start": 183.74,
  "end": 185.34,
  "text": "可師傅確對錢簡直"
 }
]